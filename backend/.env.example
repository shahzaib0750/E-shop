# Copy to backend/.env and fill in your own values. Never commit a real .env.

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:change-me@localhost:5432/eshop

# JWT secret — generate a long random string, e.g. `openssl rand -hex 32`
SECRET_KEY=change-me

# JWT algorithm (only HS256 is supported)
ALGORITHM=HS256

# Access token lifetime in minutes (1–60)
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# External API keys (optional but recommended)
PEXELS_API_KEY=
GROQ_API_KEY=
